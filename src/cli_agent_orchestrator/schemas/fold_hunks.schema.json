{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["hunks"],
  "properties": {
    "hunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor"],
        "properties": {
          "anchor": {"type": "string", "minLength": 1},
          "expect_count": {"type": "integer", "minimum": 1, "default": 1},
          "replace": {"type": "string"},
          "after": {"type": "string"},
          "strike": {"const": true}
        },
        "oneOf": [
          {"required": ["replace"]},
          {"required": ["after"]},
          {"required": ["strike"]}
        ]
      }
    }
  }
}
