{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAO Agent Profile Frontmatter",
  "description": "Validates the YAML frontmatter of a CAO agent profile .md file.",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "Unique agent identifier (filesystem-safe)."
    },
    "description": {
      "type": "string",
      "maxLength": 1024,
      "description": "Brief description of the agent's purpose."
    },
    "capabilities": {
      "type": "array",
      "items": {"type": "string", "maxLength": 128},
      "maxItems": 32,
      "description": "Short capability statements used by profile discovery (e.g. 'query dynamodb tables')."
    },
    "tags": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
      "maxItems": 32,
      "description": "Keyword tags used by profile discovery (e.g. 'sqs', 'monitoring')."
    },
    "role": {
      "type": "string",
      "description": "Agent role. Built-in values: supervisor, developer, reviewer. Custom roles are also supported via settings.json."
    },
    "protected": {
      "type": "boolean"
    },
    "provider": {
      "type": "string",
      "description": "Provider override (e.g. claude_code, kiro_cli, codex)."
    },
    "lifecycle": {
      "type": "string",
      "enum": ["ephemeral", "sticky"]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": true
    },
    "provider_init_timeout": {
      "type": "integer",
      "minimum": 1
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path_maps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "guest"],
            "properties": {
              "host": {"type": "string", "minLength": 1},
              "guest": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "contextPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": {"const": "persona"},
        "memoryTypes": {
          "type": "array",
          "items": {"enum": ["user", "feedback", "project", "reference"]},
          "default": []
        },
        "memoryNames": {
          "type": "array",
          "items": {"type": "string"},
          "default": []
        },
        "globalClaudeMd": {"type": "boolean", "default": false},
        "extraLeaves": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!(?:CLAUDE\\.md|\\.credentials\\.json|settings\\.json|persona-manifest\\.json)$)(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
          },
          "default": []
        }
      }
    },
    "engine": {
      "type": "string",
      "enum": ["v2", "kas"],
      "description": "Kiro engine selection."
    },
    "allowedTools": {
      "type": "array",
      "items": {"type": "string"},
      "description": "CAO tool vocabulary allowlist."
    },
    "mcpServers": {
      "type": "object",
      "description": "MCP server configurations for additional tools.",
      "additionalProperties": {
        "type": "object",
        "description": "One MCP server. A command-launched server sets 'command'; a remote server sets 'url', with 'type' naming its transport (for example 'http' or 'sse'). At least one of the two is required.",
        "properties": {
          "type": {"type": "string"},
          "command": {"type": "string"},
          "args": {"type": "array", "items": {"type": "string"}},
          "env": {"type": "object", "additionalProperties": {"type": "string"}},
          "timeout": {"type": "integer"},
          "url": {"type": "string"}
        },
        "anyOf": [
          {"required": ["command"]},
          {"required": ["url"]}
        ]
      }
    },
    "tools": {
      "type": "array",
      "items": {"type": "string"}
    },
    "toolAliases": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "toolsSettings": {
      "type": "object"
    },
    "model": {
      "type": "string"
    },
    "reasoningEffort": {
      "type": "string",
      "minLength": 1
    },
    "messageContract": {
      "type": "string",
      "minLength": 1
    },
    "inheritUserMcpServers": {
      "type": "boolean"
    },
    "permissionMode": {
      "type": "string",
      "enum": ["default", "acceptEdits", "plan", "auto", "bypassPermissions"]
    },
    "native_agent": {
      "type": "string"
    },
    "codexProfile": {
      "type": "string",
      "minLength": 1
    },
    "codexConfig": {
      "type": "object"
    },
    "claudeConfig": {
      "type": "object"
    },
    "hermesProfile": {
      "type": "string",
      "minLength": 1
    },
    "grokNativeWorkflows": {
      "type": "boolean",
      "default": false,
      "description": "Grok Build only. Explicitly permits Grok-native subagents, workflows, and /goal in this CAO terminal."
    },
    "skills": {
      "type": "array",
      "items": {"type": "string"}
    },
    "sessionBrief": {
      "type": "string",
      "enum": ["required", "optional"]
    },
    "prompt": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {"type": "string"}
    },
    "hooks": {
      "type": "object"
    },
    "useLegacyMcpJson": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
